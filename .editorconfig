root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.vue]
indent_size = 4

[*.{ts,tsx,js,jsx}]
indent_size = 4

[*.css]
indent_size = 4

[*.json]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab

[*.mdx]
indent_size = 2
trim_trailing_whitespace = false
